NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
APP_ORIGIN=http://localhost:5173
# For HTTPS delivery instead of SMTP, set MAIL_PROVIDER=brevo, BREVO_API_KEY,
# MAIL_FROM and MAIL_ENCRYPTION_KEY. See docs/free-hosting-email.md.
# Enable recovery email only after filling all SMTP values and a private 64-hex key.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sending-account@gmail.com
# SMTP_PASSWORD=your-google-app-password-without-spaces
# MAIL_FROM=your-sending-account@gmail.com
# MAIL_ENCRYPTION_KEY=generate-a-private-32-byte-hex-key
# Uncomment after installing MongoDB locally, or use your Atlas connection string.
# MONGODB_URI=mongodb://127.0.0.1:27017/spendwise
