# Copy privately to production.env or set equivalent hosting secrets. Never commit real values.
NODE_ENV=production
HOST=0.0.0.0
PORT=5000
SERVE_FRONTEND=true
# Set 1 ONLY when all inbound traffic comes through one trusted hosting proxy.
# Use false for a directly exposed Node server, or loopback for a local reverse proxy.
TRUST_PROXY=false
APP_ORIGIN=https://YOUR_PUBLIC_APP_DOMAIN
CLIENT_ORIGINS=https://YOUR_PUBLIC_APP_DOMAIN
MONGODB_URI=mongodb+srv://APP_USER:ENCODED_PASSWORD@YOUR_CLUSTER/spendwise?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# Copy your existing private key to preserve encrypted queued mail across deployments.
MAIL_ENCRYPTION_KEY=YOUR_PRIVATE_64_HEX_KEY
# HTTPS mail transport for free hosting. Sender must be approved by Brevo.
MAIL_PROVIDER=brevo
BREVO_API_KEY=YOUR_PRIVATE_BREVO_API_KEY
MAIL_FROM=YOUR_VERIFIED_SENDING_EMAIL
